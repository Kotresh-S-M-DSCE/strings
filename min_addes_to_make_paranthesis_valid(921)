class Solution {
    public int minAddToMakeValid(String s) {
        int ret=0;
        List<Character> list=new ArrayList<>();
        for(int i=0;i<s.length();i++)
        {
            if(s.charAt(i)==')')
            {
                if(list.size()!=0&&list.get(list.size()-1).equals('('))
                   list.remove(list.size()-1);
                else
                   list.add(')');
            }
            else
                list.add('(');
        }
        return list.size();
    }
}