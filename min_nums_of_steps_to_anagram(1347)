class Solution {
    public int minSteps(String s, String t) {
        int[] arr=new int[26];
        for(int i=0;i<s.length();i++)
        {
            arr[s.charAt(i)-'a']++;
            arr[t.charAt(i)-'a']--;
        }
        int ret=0;
        for(int i=0;i<26;i++)
        {
            if(arr[i]<0)
               arr[i]=-arr[i];
            ret+=arr[i];
        }  
        return ret/2;
    }
}