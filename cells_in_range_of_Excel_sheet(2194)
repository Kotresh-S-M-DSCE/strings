class Solution {
    public List<String> cellsInRange(String s) {
        List<String> ret=new ArrayList<>();
        for(int i=s.charAt(0)-'A';i<=s.charAt(3)-'A';i++)
        {
            for(int j=s.charAt(1)-'0';j<=s.charAt(4)-'0';j++)
            {
                StringBuilder sb=new StringBuilder();
                sb.append((char)(i+'A'));
                sb.append((char)(j+'0'));
                ret.add(sb.toString());
            }
        }
        return ret;
    }
}