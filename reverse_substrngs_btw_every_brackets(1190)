class Solution {
    public String fun(String s,int[] n,int i)
    {
        StringBuilder sb=new StringBuilder();
        for(;s.charAt(i)!=')';i++)
        {
            if(s.charAt(i)=='(')
            {
               sb.append(fun(s,n,i+1));
               i=n[0];
            }
            else
               sb.append(s.charAt(i));
        }
        n[0]=i;
        return sb.reverse().toString();
    }
    public String reverseParentheses(String s) {
        //ed(etco)el  ed(octe)el
        StringBuilder sb=new StringBuilder();
        for(int i=0;i<s.length();i++)
        {
            int[] n=new int[1];
            if(s.charAt(i)=='(')
            {
               sb.append(fun(s,n,i+1));
               i=n[0];
            }
            else
               sb.append(s.charAt(i));
        }
        return sb.toString();
    }
}