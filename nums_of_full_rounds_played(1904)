class Solution {
    public int fun(String str)
    {
        int num=0,flag=0,ret=0;
        for(int i=0;i<str.length();i++)
        {
            if(str.charAt(i)==':')
            {
                ret=num*60;
                num=0;
                continue;
            }
            num=num*10+str.charAt(i)-'0';
        }
        return ret+num;
    }
    public int numberOfRounds(String login, String logout) {
        int in=fun(login),out=fun(logout);
        if((out-in)<15&&(out-in)>0)
           return 0;
        if(in<out)
        {
            int a=in/15,b=out/15;
            if(in%15!=0)
               a+=1;
            return b-a;
        }
        int a=in/15,b=out/15;
        if(in%15!=0)
            a+=1;
        a=96-a;
        return a+b;
    }
}