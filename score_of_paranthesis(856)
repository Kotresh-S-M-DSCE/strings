class Solution {
    public int fun(String s,int low,int high)
    {
        if(high-low==1)
           return 1;
        int ret=0;
        for(int i=low+1;i<high;i++)
        {
            if(s.charAt(i)=='(')
            {
                int j,st=1;
                for(j=i+1;j<s.length()&&st>0;j++)
                {
                    if(s.charAt(j)=='(')
                        st++;
                    else
                        st--;
                }
                ret+=2*fun(s,i,j-1);
                i=j-1;
            }
        }
        return ret;
    }
    public int scoreOfParentheses(String s) {
        //()((|(()())||(())()|))
        int ret=0;
        for(int i=0;i<s.length();i++)
        {
            if(s.charAt(i)=='(')
            {
                int j,st=1;
                for(j=i+1;j<s.length()&&st>0;j++)
                {
                    if(s.charAt(j)=='(')
                       st++;
                    else
                       st--;
                }
                ret+=fun(s,i,j-1);
                i=j-1;
            }
        }
        return ret;
    }
}