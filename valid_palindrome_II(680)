class Solution {
    public boolean validPalindrome(String s) {
        int i=0,j=s.length()-1,flag1=0,flag2=0;// sutats status
        boolean bool=false;
        while(i<j)
        {
            if(s.charAt(i)!=s.charAt(j))
            {
                if(bool==false)
                {
                    j--;
                    bool=true;
                }
                else
                {
                   flag1=1;
                   break;
                }
            }
            else
            {
                i++;
                j--;
            }
        }
        i=0;
        j=s.length()-1;
        bool=false;
        while(i<j)
        {
            if(s.charAt(i)!=s.charAt(j))
            {
                if(bool==false)
                {
                    i++;
                    bool=true;
                }
                else
                {
                   flag2=1;
                   break;
                }
            }
            else
            {
                i++;
                j--;
            }
        }
        if(flag1==0||flag2==0)
            return true;
        return false;
    }
}