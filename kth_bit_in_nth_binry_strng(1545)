class Solution {
    public char fun(int n,int k)
    {
        if(n==1)
           return '0';
        int len=(1<<n)-1;
        int mid=(len+1)/2;
        if(k==mid)
           return '1';
        else if(k<mid)
           return fun(n-1,k);
        else
           return (fun(n-1,(len-k)+1)=='0') ? '1' : '0';
    }
