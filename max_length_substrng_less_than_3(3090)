class Solution {
    public int maximumLengthSubstring(String s) {
        int i=0,j=1,max=0,flag=0;
        int[] arr=new int[26];
        arr[s.charAt(0)-'a']++;
        while(j<s.length())
        {
            if(flag==0)
                arr[s.charAt(j)-'a']++;
            if(arr[s.charAt(j)-'a']>2)
            {
                if(max<(j-i))
                   max=j-i;
                arr[s.charAt(i++)-'a']--;
                if(arr[s.charAt(j)-'a']<=2)
                   flag=0;
                else 
                   flag=1;
            }
            if(flag==0)
               j++;
        }
        if((j-i)>max)
           max=j-i;
        return max;
    }
}